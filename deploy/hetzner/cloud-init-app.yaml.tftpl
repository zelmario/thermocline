#cloud-config
# The router, the daemons and the workload run here. Only the shell is
# installed; cline is copied in by bootstrap.sh.
write_files:
  # The private network's interface, by DHCP. Hetzner can attach the network
  # after first boot, and cloud-init only configures what it saw at boot: on
  # 2026-10-08 four of seven nodes came up with it down, so no member could
  # reach another. networkd configures a matching interface whenever it appears.
  - path: /etc/netplan/60-private.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          private:
            match:
              name: "enp*"
            dhcp4: true
  - path: /root/install-shell.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -q
      apt-get install -y -q gnupg2 curl lsb-release jq
      curl -fsSL -o /tmp/percona-release.deb https://repo.percona.com/apt/percona-release_latest.generic_all.deb
      apt-get install -y -q /tmp/percona-release.deb
      percona-release enable psmdb-80 release
      apt-get update -q
      apt-get install -y -q percona-mongodb-mongosh
      mkdir -p /etc/thermocline /var/log/cline
      echo "${psmdb_version}" > /root/PSMDB_WANTED
runcmd:
  - [netplan, apply]
  - [bash, /root/install-shell.sh]
